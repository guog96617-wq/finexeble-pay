generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  AGENT_ADMIN
  MERCHANT_ADMIN
}

enum EntityStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum SupplierStatus {
  ACTIVE
  DISABLED
}

enum PaymentMethod {
  CARD
  LOCAL_PAYMENT
  BANK_TRANSFER
  SANDBOX_PAY
}

enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum AttemptStatus {
  PENDING
  SUCCESS
  FAILED
}

enum RefundStatus {
  PENDING
  SUCCESS
  FAILED
}

enum WalletTransactionType {
  PAYMENT_IN
  REFUND_OUT
  FEE_OUT
  MERCHANT_FEE_OUT
  ROLLING_RESERVE_HOLD
  WITHDRAW_FREEZE
  WITHDRAW_SUCCESS
  WITHDRAW_PAID
  WITHDRAW_FAILED
  ADJUSTMENT
}

enum RollingReserveStatus {
  HELD
  RELEASED
  DEDUCTED
}

enum WithdrawStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum PluginPlatform {
  SHOPIFY
  WOOCOMMERCE
  SHOPLINE
  MAGENTO
  OPENCART
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole
  merchantId   String?   @map("merchant_id")
  agentId      String?   @map("agent_id")
  isMfaEnabled Boolean   @default(false) @map("is_mfa_enabled")
  mfaSecret    String?   @map("mfa_secret")
  status       EntityStatus @default(ACTIVE)
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  merchant Merchant? @relation(fields: [merchantId], references: [id])
  agent    Agent?    @relation(fields: [agentId], references: [id])
  auditLogs AuditLog[]

  @@map("users")
}

model Agent {
  id             String   @id @default(cuid())
  name           String
  contactName    String   @map("contact_name")
  email          String   @unique
  phone          String?
  commissionRate Decimal  @default(0) @map("commission_rate") @db.Decimal(8, 4)
  status         EntityStatus @default(PENDING)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  merchants Merchant[]
  users     User[]
  feeRules  AgentFeeRule[]
  withdrawRules WithdrawRule[]
  agentChannels AgentChannel[]

  @@map("agents")
}

model Merchant {
  id          String   @id @default(cuid())
  agentId     String?  @map("agent_id")
  name        String
  contactName String   @map("contact_name")
  email       String   @unique
  phone       String?
  country     String?
  website     String?
  status      EntityStatus @default(PENDING)
  feeRate     Decimal  @default(0.029) @map("fee_rate") @db.Decimal(8, 4)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  agent              Agent?              @relation(fields: [agentId], references: [id])
  users              User[]
  orders             Order[]
  refunds            Refund[]
  wallet             Wallet?
  walletTransactions WalletTransaction[]
  withdraws          Withdraw[]
  apiKeys            ApiKey[]
  webhooks           Webhook[]
  webhookLogs        WebhookLog[]
  merchantChannels   MerchantChannel[]
  withdrawRules      WithdrawRule[]
  rollingReserveRecords RollingReserveRecord[]

  @@map("merchants")
}

model Supplier {
  id          String   @id @default(cuid())
  name        String
  country     String?
  contactName String?  @map("contact_name")
  email       String?
  apiBaseUrl  String   @map("api_base_url")
  status      SupplierStatus @default(ACTIVE)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  channels Channel[]

  @@map("suppliers")
}

model Channel {
  id            String   @id @default(cuid())
  supplierId    String?  @map("supplier_id")
  name          String
  supplierName  String?  @map("supplier_name")
  supplierContactName String? @map("supplier_contact_name")
  supplierApiBaseUrl String? @map("supplier_api_base_url")
  supplierNote  String?  @map("supplier_note")
  paymentMethod PaymentMethod @map("payment_method")
  country       String?
  currency      String
  feeRate       Decimal  @default(0.02) @map("fee_rate") @db.Decimal(8, 4)
  pspCostRate   Decimal  @default(0.02) @map("psp_cost_rate") @db.Decimal(8, 4)
  pspFixedFee   Decimal  @default(0) @map("psp_fixed_fee") @db.Decimal(18, 2)
  rollingReserveRate Decimal @default(0) @map("rolling_reserve_rate") @db.Decimal(8, 4)
  rollingReserveDays Int @default(0) @map("rolling_reserve_days")
  description   String?
  priority      Int      @default(100)
  isPrimary     Boolean  @default(false) @map("is_primary")
  isBackup      Boolean  @default(false) @map("is_backup")
  status        SupplierStatus @default(ACTIVE)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  supplier Supplier? @relation(fields: [supplierId], references: [id])
  orders   Order[]
  attempts PaymentAttempt[]
  merchantChannels MerchantChannel[]
  agentChannels AgentChannel[]
  rollingReserveRecords RollingReserveRecord[]

  @@map("channels")
}

model AgentChannel {
  id              String   @id @default(cuid())
  agentId         String   @map("agent_id")
  channelId       String   @map("channel_id")
  isEnabled       Boolean  @default(true) @map("is_enabled")
  agentFeeRate    Decimal  @default(0.1) @map("agent_fee_rate") @db.Decimal(8, 4)
  agentFixedFee   Decimal  @default(0) @map("agent_fixed_fee") @db.Decimal(18, 2)
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  agent   Agent   @relation(fields: [agentId], references: [id])
  channel Channel @relation(fields: [channelId], references: [id])

  @@unique([agentId, channelId])
  @@map("agent_channels")
}

model Order {
  id              String   @id @default(cuid())
  merchantId      String   @map("merchant_id")
  channelId       String?  @map("channel_id")
  orderNo         String   @unique @map("order_no")
  merchantOrderNo String   @map("merchant_order_no")
  amount          Decimal  @db.Decimal(18, 2)
  currency        String
  feeAmount       Decimal  @default(0) @map("fee_amount") @db.Decimal(18, 2)
  netAmount       Decimal  @default(0) @map("net_amount") @db.Decimal(18, 2)
  merchantFeeAmount Decimal @default(0) @map("merchant_fee_amount") @db.Decimal(18, 2)
  agentProfitAmount Decimal @default(0) @map("agent_profit_amount") @db.Decimal(18, 2)
  platformProfitAmount Decimal @default(0) @map("platform_profit_amount") @db.Decimal(18, 2)
  pspCostAmount Decimal @default(0) @map("psp_cost_amount") @db.Decimal(18, 2)
  merchantNetBeforeReserve Decimal @default(0) @map("merchant_net_before_reserve") @db.Decimal(18, 2)
  rollingReserveAmount Decimal @default(0) @map("rolling_reserve_amount") @db.Decimal(18, 2)
  merchantAvailableAmount Decimal @default(0) @map("merchant_available_amount") @db.Decimal(18, 2)
  status          OrderStatus @default(PENDING)
  paymentUrl      String?  @map("payment_url")
  customerEmail   String?  @map("customer_email")
  customerIp      String?  @map("customer_ip")
  paidAt          DateTime? @map("paid_at")
  failedReason    String?  @map("failed_reason")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])
  channel  Channel? @relation(fields: [channelId], references: [id])
  attempts PaymentAttempt[]
  refunds  Refund[]
  webhookLogs WebhookLog[]
  rollingReserveRecords RollingReserveRecord[]

  @@map("orders")
}

model PaymentAttempt {
  id              String   @id @default(cuid())
  orderId         String   @map("order_id")
  channelId       String   @map("channel_id")
  attemptNo       Int      @map("attempt_no")
  status          AttemptStatus
  requestPayload  Json?    @map("request_payload")
  responsePayload Json?    @map("response_payload")
  errorMessage    String?  @map("error_message")
  createdAt       DateTime @default(now()) @map("created_at")

  order   Order   @relation(fields: [orderId], references: [id])
  channel Channel @relation(fields: [channelId], references: [id])

  @@map("payment_attempts")
}

model Refund {
  id         String   @id @default(cuid())
  orderId    String   @map("order_id")
  merchantId String   @map("merchant_id")
  refundNo   String   @unique @map("refund_no")
  amount     Decimal  @db.Decimal(18, 2)
  reason     String?
  status     RefundStatus @default(PENDING)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  order    Order    @relation(fields: [orderId], references: [id])
  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@map("refunds")
}

model Wallet {
  id               String   @id @default(cuid())
  merchantId       String   @unique @map("merchant_id")
  balance          Decimal  @default(0) @db.Decimal(18, 2)
  availableBalance Decimal  @default(0) @map("available_balance") @db.Decimal(18, 2)
  frozenBalance    Decimal  @default(0) @map("frozen_balance") @db.Decimal(18, 2)
  rollingReserveBalance Decimal @default(0) @map("rolling_reserve_balance") @db.Decimal(18, 2)
  currency         String   @default("USD")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  merchant     Merchant @relation(fields: [merchantId], references: [id])
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id            String   @id @default(cuid())
  walletId      String   @map("wallet_id")
  merchantId    String   @map("merchant_id")
  type          WalletTransactionType
  amount        Decimal  @db.Decimal(18, 2)
  balanceAfter  Decimal  @map("balance_after") @db.Decimal(18, 2)
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id")
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")

  wallet   Wallet   @relation(fields: [walletId], references: [id])
  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@map("wallet_transactions")
}

model Withdraw {
  id          String   @id @default(cuid())
  merchantId  String   @map("merchant_id")
  withdrawNo  String   @unique @map("withdraw_no")
  amount      Decimal  @db.Decimal(18, 2)
  feeAmount   Decimal  @default(0) @map("fee_amount") @db.Decimal(18, 2)
  actualPayout Decimal @default(0) @map("actual_payout") @db.Decimal(18, 2)
  currency    String
  bankName    String   @map("bank_name")
  bankAccount String   @map("bank_account")
  accountName String   @map("account_name")
  status      WithdrawStatus @default(PENDING)
  reviewedBy  String?  @map("reviewed_by")
  reviewedAt  DateTime? @map("reviewed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@map("withdraws")
}

model MerchantChannel {
  id                  String   @id @default(cuid())
  merchantId          String   @map("merchant_id")
  channelId           String   @map("channel_id")
  isEnabled           Boolean  @default(true) @map("is_enabled")
  isPrimary           Boolean  @default(false) @map("is_primary")
  isBackup            Boolean  @default(false) @map("is_backup")
  merchantFeeRate     Decimal  @default(0.029) @map("merchant_fee_rate") @db.Decimal(8, 4)
  merchantFixedFee    Decimal  @default(0) @map("merchant_fixed_fee") @db.Decimal(18, 2)
  minFee              Decimal  @default(0) @map("min_fee") @db.Decimal(18, 2)
  maxFee              Decimal? @map("max_fee") @db.Decimal(18, 2)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])
  channel  Channel  @relation(fields: [channelId], references: [id])

  @@unique([merchantId, channelId])
  @@map("merchant_channels")
}

model RollingReserveRecord {
  id             String   @id @default(cuid())
  merchantId     String   @map("merchant_id")
  orderId        String   @map("order_id")
  channelId      String   @map("channel_id")
  amount         Decimal  @db.Decimal(18, 2)
  status         RollingReserveStatus @default(HELD)
  holdDays       Int      @default(0) @map("hold_days")
  releaseAt      DateTime? @map("release_at")
  releasedAt     DateTime? @map("released_at")
  deductedAmount Decimal  @default(0) @map("deducted_amount") @db.Decimal(18, 2)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])
  order    Order    @relation(fields: [orderId], references: [id])
  channel  Channel  @relation(fields: [channelId], references: [id])

  @@map("rolling_reserve_records")
}

model WithdrawRule {
  id                  String   @id @default(cuid())
  merchantId          String?  @map("merchant_id")
  agentId             String?  @map("agent_id")
  currency            String   @default("USD")
  minAmount           Decimal  @default(1) @map("min_amount") @db.Decimal(18, 2)
  maxAmount           Decimal  @default(10000) @map("max_amount") @db.Decimal(18, 2)
  withdrawFeeRate     Decimal  @default(0.01) @map("withdraw_fee_rate") @db.Decimal(8, 4)
  withdrawFixedFee    Decimal  @default(0) @map("withdraw_fixed_fee") @db.Decimal(18, 2)
  settlementDays      Int      @default(1) @map("settlement_days")
  requireManualReview Boolean  @default(true) @map("require_manual_review")
  status              EntityStatus @default(ACTIVE)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  merchant Merchant? @relation(fields: [merchantId], references: [id])
  agent    Agent?    @relation(fields: [agentId], references: [id])

  @@unique([merchantId, currency])
  @@unique([agentId, currency])
  @@map("withdraw_rules")
}

model AgentFeeRule {
  id                     String   @id @default(cuid())
  agentId                String   @map("agent_id")
  minMerchantFeeRate     Decimal  @default(0.1) @map("min_merchant_fee_rate") @db.Decimal(8, 4)
  minWithdrawFeeRate     Decimal  @default(0.01) @map("min_withdraw_fee_rate") @db.Decimal(8, 4)
  allowedPaymentMethods  Json     @default("[]") @map("allowed_payment_methods")
  allowedSupplierIds     Json     @default("[]") @map("allowed_supplier_ids")
  allowedChannelIds      Json     @default("[]") @map("allowed_channel_ids")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  agent Agent @relation(fields: [agentId], references: [id])

  @@unique([agentId])
  @@map("agent_fee_rules")
}

model ApiKey {
  id            String   @id @default(cuid())
  merchantId    String   @map("merchant_id")
  apiKey        String   @unique @map("api_key")
  apiSecretHash String   @map("api_secret_hash")
  status        EntityStatus @default(ACTIVE)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@map("api_keys")
}

model Webhook {
  id         String   @id @default(cuid())
  merchantId String   @map("merchant_id")
  url        String
  secret     String
  status     EntityStatus @default(ACTIVE)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])

  @@map("webhooks")
}

model WebhookLog {
  id              String   @id @default(cuid())
  merchantId      String   @map("merchant_id")
  orderId         String?  @map("order_id")
  url             String
  requestPayload  Json?    @map("request_payload")
  responseStatus  Int?     @map("response_status")
  responseBody    String?  @map("response_body")
  status          AttemptStatus
  createdAt       DateTime @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id])
  order    Order?   @relation(fields: [orderId], references: [id])

  @@map("webhook_logs")
}

model Plugin {
  id          String   @id @default(cuid())
  name        String
  platform    PluginPlatform
  description String?
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  versions PluginVersion[]

  @@map("plugins")
}

model PluginVersion {
  id          String   @id @default(cuid())
  pluginId    String   @map("plugin_id")
  version     String
  downloadUrl String   @map("download_url")
  releaseNote String?  @map("release_note")
  status      EntityStatus @default(ACTIVE)
  createdAt   DateTime @default(now()) @map("created_at")

  plugin Plugin @relation(fields: [pluginId], references: [id])

  @@map("plugin_versions")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  module    String
  ip        String?
  userAgent String?  @map("user_agent")
  beforeData Json?   @map("before_data")
  afterData  Json?   @map("after_data")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model SystemConfig {
  id          String   @id @default(cuid())
  configKey   String   @unique @map("config_key")
  configValue String   @map("config_value")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_configs")
}
