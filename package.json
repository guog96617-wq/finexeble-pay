{
  "name": "global-payment-hub-starter",
  "version": "1.1.0",
  "private": true,
  "description": "Global Payment Hub Starter V1.1 monorepo",
  "scripts": {
    "dev": "corepack pnpm --parallel --filter api --filter web dev",
    "build": "corepack pnpm --recursive build",
    "lint": "corepack pnpm --recursive lint",
    "db:generate": "corepack pnpm --filter api prisma:generate",
    "db:migrate": "corepack pnpm --filter api prisma:migrate",
    "db:seed": "corepack pnpm --filter api prisma:seed"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.3"
}
